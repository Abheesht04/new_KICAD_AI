(copper_parts
  (schema 1)
  (part
    (id "resistor_test_10k")
    (kind R)
    (manufacturer "Copper Test Devices")
    (mpn "CTR-10K-0603")
    (package "0603")
    (description "10 kohm chip resistor")
    (symbol "Device:R")
    (footprint "Resistor_SMD:R_0603_1608Metric")
    (identity_source (url "https://example.invalid/ctr-10k.pdf")
