    (ratings (rating resistance nominal 10000000000 uohm (source (url "https://example.invalid/nominal") (document "Nominal value") (status "unverified"))))
    (pins (pin "terminal_1" "1" "1") (pin "terminal_2" "2" "2")))
  (part
    (id "resistor_inferred_10k")
    (kind R)
    (manufacturer "Copper Test Devices")
    (mpn "CTR-10K-INFERRED")
    (package "0603")
    (description "10 kohm chip resistor with unresolved pin map")
    (symbol "Device:R")
    (footprint "Resistor_SMD:R_0603_1608Metric")
    (ratings (rating resistance nominal 10000000000 uohm (source (url "https://example.invalid/nominal") (document "Nominal value") (status "unverified")))))
  (part
    (id "resistor_sparse_10k")
    (kind R)
    (description "Generic 10k resistor")
    (aliases (alias "10k resistor") (alias "chip resistor"))))
