; Runtime ruleset for rigid FR-4. Each rule has its own source and observation date.
; Values are integer nanometres. Limits are configurable data, not C constants.
(copper_fab_rules
  (schema 1)
  (ruleset "jlcpcb.rigid.fr4")
  (fabricator "JLCPCB")
  (rules
    (rule (id "trace_min_1oz_2l") (kind "min_track_width") (value_nm 100000) (layers_max 2) (copper_oz_x10 10) (severity required) (note "1- and 2-layer, 1 oz: 0.10 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "trace_min_1oz_ml") (kind "min_track_width") (value_nm 90000) (layers_min 4) (copper_oz_x10 10) (severity required) (note "Multilayer, 1 oz: 0.09 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "trace_min_2oz_2l") (kind "min_track_width") (value_nm 160000) (layers_max 2) (copper_oz_x10 20) (severity required) (note "2-layer, 2 oz: 0.16 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "trace_min_2oz_ml") (kind "min_track_width") (value_nm 150000) (layers_min 4) (copper_oz_x10 20) (severity required) (note "Multilayer, 2 oz: 0.15 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "trace_min_2p5oz_2l") (kind "min_track_width") (value_nm 200000) (layers_max 2) (copper_oz_x10 25) (severity required) (note "2-layer, 2.5 oz: 0.20 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "trace_min_3p5oz_2l") (kind "min_track_width") (value_nm 250000) (layers_max 2) (copper_oz_x10 35) (severity required) (note "2-layer, 3.5 oz: 0.25 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "trace_min_4p5oz_2l") (kind "min_track_width") (value_nm 300000) (layers_max 2) (copper_oz_x10 45) (severity required) (note "2-layer, 4.5 oz: 0.30 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "space_min_1oz_2l") (kind "min_clearance_copper") (value_nm 100000) (layers_max 2) (copper_oz_x10 10) (severity required) (note "1- and 2-layer, 1 oz: 0.10 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "space_min_1oz_ml") (kind "min_clearance_copper") (value_nm 90000) (layers_min 4) (copper_oz_x10 10) (severity required) (note "Multilayer, 1 oz: 0.09 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "space_min_2oz_2l") (kind "min_clearance_copper") (value_nm 160000) (layers_max 2) (copper_oz_x10 20) (severity required) (note "2-layer, 2 oz: 0.16 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "space_min_2oz_ml") (kind "min_clearance_copper") (value_nm 150000) (layers_min 4) (copper_oz_x10 20) (severity required) (note "Multilayer, 2 oz: 0.15 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "space_min_2p5oz_2l") (kind "min_clearance_copper") (value_nm 200000) (layers_max 2) (copper_oz_x10 25) (severity required) (note "2-layer, 2.5 oz: 0.20 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "space_min_3p5oz_2l") (kind "min_clearance_copper") (value_nm 250000) (layers_max 2) (copper_oz_x10 35) (severity required) (note "2-layer, 3.5 oz: 0.25 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "space_min_4p5oz_2l") (kind "min_clearance_copper") (value_nm 300000) (layers_max 2) (copper_oz_x10 45) (severity required) (note "2-layer, 4.5 oz: 0.30 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "drill_min_mech") (kind "min_drill") (value_nm 150000) (layers_min 2) (severity required) (note "2-layer and multilayer: 0.15 mm regular; 0.10 mm conditional on board thickness and finish") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "drill_min_1l") (kind "min_drill") (value_nm 300000) (layers_max 1) (severity required) (note "1-layer: 0.30 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "via_hole_min") (kind "min_via_drill") (value_nm 150000) (layers_min 2) (severity required) (note "Standard via hole 0.15 mm; 0.10 mm only under specified thin-board/finish conditions") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "via_diameter_min") (kind "min_via_diameter") (value_nm 250000) (layers_min 2) (severity required) (note "Standard via diameter 0.25 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "via_annular_min") (kind "min_via_annular_ring") (value_nm 50000) (layers_min 2) (severity required) (note "Via diameter should be 0.10 mm larger than hole; 0.15 mm preferred (radial ring 0.05/0.075 mm)") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "npth_min") (kind "min_npth_drill") (value_nm 500000) (severity required) (note "Minimum non-plated hole 0.50 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "pth_slot_2l") (kind "min_plated_slot_width") (value_nm 500000) (layers_max 2) (severity required) (note "2-layer plated slot width 0.50 mm; slot length at least 2 times width") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "pth_slot_ml") (kind "min_plated_slot_width") (value_nm 350000) (layers_min 4) (severity required) (note "Multilayer plated slot width 0.35 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "npth_slot") (kind "min_unplated_slot_width") (value_nm 1000000) (severity required) (note "Minimum non-plated slot width 1.0 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "hole_hole_via") (kind "min_hole_to_hole_via") (value_nm 200000) (severity required) (note "Via hole-to-hole spacing 0.20 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "hole_hole_pad") (kind "min_hole_to_hole_pad") (value_nm 450000) (severity required) (note "Pad hole-to-hole spacing 0.45 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "ar_2l_1oz_abs") (kind "min_annular_ring") (value_nm 180000) (layers_max 2) (copper_oz_x10 10) (severity required) (note "2-layer 1 oz PTH absolute minimum 0.18 mm; 0.25 mm recommended") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "ar_ml_1oz_abs") (kind "min_annular_ring") (value_nm 150000) (layers_min 4) (copper_oz_x10 10) (severity required) (note "Multilayer 1 oz PTH absolute minimum 0.15 mm; 0.20 mm recommended") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "ar_2oz") (kind "min_annular_ring") (value_nm 254000) (copper_oz_x10 20) (severity required) (note "2 oz PTH annular ring 0.254 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "ar_npth_recommended") (kind "min_npth_pad_ring") (value_nm 450000) (severity recommended) (note "Recommended NPTH pad ring 0.45 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "smd_pad_pad") (kind "min_pad_to_pad_diffnet") (value_nm 150000) (severity required) (note "Different-net SMD pad spacing minimum 0.15 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "smd_pad_min") (kind "min_smd_pad_size") (value_nm 250000) (severity required) (note "Minimum SMD pad dimension 0.25 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "pad_track") (kind "min_pad_to_track") (value_nm 100000) (severity required) (note "Pad-to-track clearance 0.10 mm; BGA local limit 0.09 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "via_hole_track") (kind "min_viahole_to_track") (value_nm 200000) (severity required) (note "Via-hole-to-track clearance 0.20 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "pth_track") (kind "min_pth_to_track") (value_nm 280000) (severity required) (note "PTH-to-track clearance 0.28 mm; 0.35 mm recommended") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "npth_track") (kind "min_npth_to_track") (value_nm 200000) (severity required) (note "NPTH-to-track clearance 0.20 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "mask_expansion_1to1") (kind "soldermask_expansion") (value_nm 0) (severity required) (note "Soldermask opening can be 1:1 with pad size; preserve the selected board plot/process settings") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "mask_bridge_1oz") (kind "min_mask_bridge") (value_nm 100000) (copper_oz_x10 10) (mask_color "standard") (severity required) (note "Soldermask bridge 0.10 mm for green/red/yellow/blue/purple") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "mask_bridge_1oz_bw") (kind "min_mask_bridge") (value_nm 130000) (copper_oz_x10 10) (mask_color "black_white") (severity required) (note "Soldermask bridge 0.13 mm for black/white") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "mask_bridge_2oz") (kind "min_mask_bridge") (value_nm 200000) (copper_oz_x10 20) (severity required) (note "Soldermask bridge 0.20 mm for 2 oz") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "mask_to_trace") (kind "min_mask_opening_to_trace") (value_nm 90000) (severity required) (note "Keep at least 0.09 mm between soldermask openings and neighbouring traces") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "silk_line") (kind "min_silk_line_width") (value_nm 150000) (severity required) (note "Legend minimum line width 0.15 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "silk_text_h") (kind "min_silk_text_height") (value_nm 1000000) (severity required) (note "Legend minimum text height 1.0 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "silk_pad") (kind "min_silk_to_pad") (value_nm 150000) (severity required) (note "Pad-to-silkscreen minimum distance 0.15 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "edge_routed") (kind "min_copper_to_edge") (value_nm 200000) (edge "routed") (severity required) (note "Copper to routed board edge 0.20 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "edge_vcut") (kind "min_copper_to_edge") (value_nm 400000) (edge "vcut") (severity required) (note "Copper to V-cut edge 0.40 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "board_min_dimension") (kind "min_board_dimension") (value_nm 3000000) (severity required) (note "FR-4 minimum dimension 3 mm for board thickness >=0.6 mm; thinner boards require review") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "board_thickness_min") (kind "min_board_thickness") (value_nm 400000) (severity required) (note "FR-4 thickness minimum 0.4 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
    (rule (id "board_thickness_max") (kind "max_board_thickness") (value_nm 4500000) (severity required) (note "FR-4 thickness maximum 4.5 mm") (source_url "https://jlcpcb.com/capabilities/Capabilities") (retrieved "2026-11-15"))
  )
)
