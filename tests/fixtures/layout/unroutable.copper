; Layout fixture: two fixed connectors on either side of a board keepout band that bans tracks and vias
; on both layers across the full height. No route exists: the optimizer must say so.
(copper_project
  (version 2)
  (name "unroutable")
  (nets GND A B C)
  (board 40 20 1.6 0.035 2)
  (parts
    (part
      resistor
      (kind R)
      (symbol "Device:R")
      (footprint "Resistor_SMD:R_0603_1608Metric")
      (catalogue "bundled:default.parts")
    )
    (part
      header3
      (kind J)
      (symbol "Connector_Generic:Conn_01x03")
      (footprint "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical")
      (catalogue "bundled:default.parts")
    )
  )
  (components
    (component
      J1
      (part header3)
      (pins
        (1 A)
        (2 C)
        (3 B)
      )
      (at 4 7 0)
      (fixed)
    )
    (component
      J2
      (part header3)
      (pins
        (1 B)
        (2 C)
        (3 A)
      )
      (at 36 7 0)
      (fixed)
    )
    (component
      R1
      (part resistor)
      (value 1000)
      (pins
        (1 C)
        (2 GND)
      )
      (at 8 16 0)
      (fixed)
    )
    (component
      R2
      (part resistor)
      (value 1000)
      (pins
        (1 GND)
        (2 A)
      )
      (at 32 16 0)
      (fixed)
    )
  )
  (keepouts
    (area 18 0 22 20 3 3)
  )
)
