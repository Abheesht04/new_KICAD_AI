{
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "assumptions", "open_questions"],
  "properties": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "project", "components"],
      "properties": {
        "schema": {"type": "string", "enum": ["copper.design-intent"]},
        "schema_version": {"type": "integer", "enum": [1]},
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "board"],
          "properties": {
            "name": {"type": "string"},
            "board": {
              "type": "object",
              "additionalProperties": false,
              "required": ["width_mm", "height_mm", "layers"],
              "properties": {
                "width_mm": {"type": "number"},
                "height_mm": {"type": "number"},
                "layers": {"type": "integer", "enum": [2]}
              }
            }
          }
        },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["reference", "value", "symbol_id", "footprint_id", "position", "pins"],
            "properties": {
              "reference": {"type": "string"},
              "value": {"type": "string"},
              "symbol_id": {"type": "string"},
              "footprint_id": {"type": "string"},
              "position": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x_mm", "y_mm", "rotation_deg"],
                "properties": {
                  "x_mm": {"type": "number"},
                  "y_mm": {"type": "number"},
                  "rotation_deg": {"type": "number"}
                }
              },
              "pins": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["symbol_pin", "pin_name", "pad", "net"],
                  "properties": {
                    "symbol_pin": {"type": "string"},
                    "pin_name": {"type": "string"},
                    "pad": {"type": "string"},
                    "net": {"type": ["string", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "open_questions": {"type": "array", "items": {"type": "string"}}
  }
}
